+/* ==========================================================================
+   Beamer-Design „Wer stiehlt uns die Show“: Neon-Studiobühne
+   ========================================================================== */
+
+body.beamer-page { background: #05060f; }
+.studio-bg { position: fixed; inset: 0; z-index: -1; overflow: hidden; background: radial-gradient(ellipse 70% 60% at 50% 38%, #141a3c 0%, #070818 60%, #03040b 100%); }
+.studio-bg svg { position: absolute; inset: 0; width: 100%; height: 100%; }
+.studio-bg .tri { fill: none; stroke: #ff3d7f; stroke-width: 2.4; filter: url(#neon); opacity: 0.9; }
+.studio-bg .tri.dim { opacity: 0.45; }
+.studio-bg .beam-pink { fill: #ff2d8a; filter: url(#neon); }
+.studio-bg .beam-cyan { fill: #1fd6f2; filter: url(#neon); }
+.studio-bg .floor-line { fill: none; stroke-width: 3; filter: url(#neon); }
+.studio-bg .spot { fill: url(#spot); mix-blend-mode: screen; }
+.studio-bg .tri { animation: neonFlicker 6s ease-in-out infinite; }
+.studio-bg .tri:nth-child(3n) { animation-delay: -2s; }
+.studio-bg .tri:nth-child(5n) { animation-delay: -4s; }
+@keyframes neonFlicker { 0%, 100% { opacity: 0.9; } 48% { opacity: 0.9; } 50% { opacity: 0.55; } 52% { opacity: 0.9; } }
+
+.beamer { font-family: var(--font-display); }
+
+/* Show-Logo: Wörter gestapelt, weiß mit schwarzer Kontur, „UNS“ in Neon-Pink */
+.show-logo { display: inline-flex; flex-direction: column; align-items: center; line-height: 0.92; font-weight: 800; text-transform: uppercase; font-size: clamp(1rem, min(9.5vw, 13vh), 10rem); letter-spacing: 0.02em; }
+.show-logo span { color: #fff; -webkit-text-stroke: 0.045em #0a0a0a; paint-order: stroke fill; text-shadow: 0.05em 0.06em 0 rgba(0, 0, 0, 0.85); animation: logoIn calc(0.6s * var(--speed)) cubic-bezier(.2,1.4,.4,1) both; }
+.show-logo span.hot { font-size: 1.55em; line-height: 0.9; color: #ff4fb0; -webkit-text-stroke: 0.035em #ffd0ea; text-shadow: 0.045em 0.05em 0 #b0125f, 0 0 0.4em rgba(255, 45, 138, 0.55); }
+.show-logo.small { font-size: clamp(0.55rem, min(2.4vw, 3.6vh), 2.6rem); }
+@keyframes logoIn { from { transform: translateY(0.4em) scale(0.6); opacity: 0; } to { transform: none; opacity: 1; } }
+
+.beamer .sub { font-weight: 600; letter-spacing: 0.02em; }
+.beamer .kicker { font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-3); font-size: clamp(0.8rem, 2vw, 2rem); text-shadow: 0 0 0.6em rgba(31, 214, 242, 0.6); }
+
+/* 4-2-2-Pyramide */
+.pyr-wrap { width: min(86vw, 98vh); margin: 0 auto; }
+.pyr-wrap svg { width: 100%; height: auto; display: block; overflow: visible; }
+.pyr-band { animation: bandIn calc(0.5s * var(--speed)) ease-out both; transform-box: fill-box; transform-origin: center; }
+.pyr-label { font-family: var(--font-display); font-weight: 700; fill: #fff; text-transform: uppercase; letter-spacing: 0.03em; }
+.pyr-stage { font-family: var(--font-display); font-weight: 800; font-style: italic; fill: #111; text-transform: uppercase; }
+.pyr-finale { font-family: var(--font-display); font-weight: 800; fill: #fff; letter-spacing: 0.04em; paint-order: stroke fill; stroke: rgba(80, 40, 0, 0.45); stroke-width: 3; }
+.pyr-current { animation: bandIn calc(0.5s * var(--speed)) ease-out both, currentGlow 1.4s ease-in-out infinite alternate; }
+@keyframes bandIn { from { transform: scaleX(0.3); opacity: 0; } to { transform: none; opacity: 1; } }
+@keyframes currentGlow { from { filter: drop-shadow(0 0 6px #ff2d8a); } to { filter: drop-shadow(0 0 26px #ff2d8a) drop-shadow(0 0 8px #ff7cc0); } }
+
+/* Spieltitel: Bildschirm mit Kachelschrift in Lachs */
+.tv { position: relative; width: min(92vw, 150vh); aspect-ratio: 16 / 10; margin: 0 auto; border-radius: 1.2vh; padding: 2.2vh; background: linear-gradient(#2a2d36, #15171d); box-shadow: 0 0 0 0.5vh #3b3f4a, 0 3vh 6vh rgba(0, 0, 0, 0.7); }
+.tv.compact { width: min(80vw, 120vh); }
+.tv-screen { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--tv, var(--salmon)); border-radius: 0.6vh; display: flex; align-items: center; justify-content: center; }
+.tv-tiles { position: absolute; inset: -10% -5%; display: flex; flex-direction: column; justify-content: space-between; transform: rotate(0deg); }
+.tv-tiles div { white-space: nowrap; font-weight: 800; font-size: clamp(0.8rem, 4.3vh, 3.4rem); line-height: 1; color: #120a0a; text-transform: uppercase; animation: tilesLeft calc(26s * var(--speed)) linear infinite; }
+.tv-tiles div:nth-child(even) { animation-name: tilesRight; }
+.tv-tiles .ghost { color: transparent; -webkit-text-stroke: 1px rgba(20, 10, 10, 0.35); }
+@keyframes tilesLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
+@keyframes tilesRight { from { transform: translateX(-50%); } to { transform: translateX(0); } }
+.tv-plate { position: relative; z-index: 1; max-width: 88%; background: var(--tv, var(--salmon)); padding: 2.4vh 4vw; box-shadow: 0 0 0 2.6vh var(--tv, var(--salmon)); }
+.tv-title { font-weight: 800; text-transform: uppercase; line-height: 0.95; font-size: clamp(1rem, min(7.2vw, 13vh), 8.5rem); color: #0d0909; -webkit-text-stroke: 0.06em #fff; paint-order: stroke fill; text-shadow: 0.07em 0.08em 0 rgba(0, 0, 0, 0.85); text-wrap: balance; }
+.tv-title { hyphens: none; overflow-wrap: normal; word-break: keep-all; }
+.tv-title .word { display: inline-block; white-space: nowrap; }
+.tv-title .word span { display: inline-block; animation: letterDrop calc(0.5s * var(--speed)) cubic-bezier(.2,1.5,.4,1) both; }
+.tv-num { display: block; font-weight: 800; font-size: clamp(0.7rem, 3.4vh, 2.4rem); letter-spacing: 0.12em; color: #fff; text-transform: uppercase; margin-bottom: 1vh; text-shadow: 0 0.08em 0 rgba(0, 0, 0, 0.5); }
+@keyframes letterDrop { from { transform: translateY(-0.6em) rotate(-10deg); opacity: 0; } to { transform: none; opacity: 1; } }
+
+/* Studioszenen aus den Show-Bildern (Teampulte, Moderationspult) */
+.scene { position: relative; margin: 0 auto; }
+.scene > img:not(.scene-coin) { display: block; width: 100%; height: auto; user-select: none; -webkit-user-drag: none; border-radius: 1vh; }
+.scene .overlay { position: absolute; display: flex; align-items: center; justify-content: center; text-align: center; background: #000; color: #fff; font-weight: 800; line-height: 1; overflow: hidden; }
+.scene-teams { width: min(94vw, 165vh); }
+.scene-teams .overlay { font-size: clamp(0.5rem, 2.6vw, 4.2vh); border-radius: 2px; }
+.scene-teams .name-unused { position: absolute; translate: -50% 0; bottom: -0.2em; white-space: nowrap; font-weight: 800; font-size: clamp(0.6rem, 1.5vw, 3vh); padding: 0.25em 0.7em; border-radius: 999px; background: rgba(5, 6, 15, 0.82); border-bottom: 0.25em solid var(--team); animation: logoIn calc(0.5s * var(--speed)) ease-out both; }
+.scene-pult { width: min(94vw, 150vh); container-type: inline-size; }
+.scene-pult .overlay { flex-direction: column; gap: 0.1em; text-transform: uppercase; letter-spacing: 0.02em; }
+.scene-pult .overlay small { font-size: 1.85cqw; font-weight: 800; }
+.scene-pult .overlay b { font-size: 7cqw; line-height: 0.9; color: #fff; text-shadow: 0 0 0.25em rgba(255, 45, 138, 0.9); }
+.scene-banner { position: absolute; left: 50%; bottom: 6%; translate: -50% 0; white-space: nowrap; font-weight: 800; text-transform: uppercase; font-size: clamp(0.8rem, 4vw, 7vh); padding: 0.2em 0.8em; border-radius: 0.3em; background: #fff; color: #0b0b0b; border-bottom: 0.18em solid var(--team, var(--accent)); box-shadow: 0 0.3em 1em rgba(0, 0, 0, 0.6); animation: logoIn calc(0.6s * var(--speed)) calc(4.2s * var(--speed)) cubic-bezier(.2,1.4,.4,1) both; }
+.scene-coin { position: absolute; left: 50%; top: 18%; width: 16%; height: auto; margin-left: -8%; filter: drop-shadow(0 0 3vh rgba(255, 170, 110, 0.75)) drop-shadow(0 1vh 1.5vh rgba(0, 0, 0, 0.6)); animation: spin calc(2.4s * var(--speed)) ease-out both, coinAway 0.6s calc(2.4s * var(--speed)) ease-in forwards; }
+@keyframes coinAway { to { transform: translateY(40vh) scale(0.4); opacity: 0; } }
+/* Münzen auf dem Moderationspult; die vergebene hebt ab und wird zur großen Münze */
+.scene-pult .pult-coin { position: absolute; height: auto; filter: drop-shadow(0 0.3vh 0.4vh rgba(0, 0, 0, 0.55)); }
+.scene-pult .pult-coin.lift { animation: pultLift calc(1.4s * var(--speed)) calc(1.2s * var(--speed)) ease-in forwards; }
+@keyframes pultLift { 40% { transform: translateY(-15%) scale(1.15); filter: drop-shadow(0 0 2vh rgba(255, 170, 110, 0.9)); } to { transform: translateY(-500%) scale(2.2); opacity: 0; } }
+.scene-coin.from-pult { animation: spinIn calc(4.2s * var(--speed)) calc(2.2s * var(--speed)) ease-out both, coinAway calc(1s * var(--speed)) calc(6.4s * var(--speed)) ease-in forwards; }
+/* Moderationspult bei der Münzvergabe bildschirmfüllend (Bild deckt den ganzen Beamer ab) */
+.scene-pult.full { position: fixed; left: 50%; top: 50%; width: max(100vw, calc(100vh * 938 / 530)); translate: -50% -50%; margin: 0; z-index: 1; }
+.scene-pult.full > img:not(.scene-coin):not(.pult-coin) { border-radius: 0; }
