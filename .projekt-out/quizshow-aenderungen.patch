+      log(db, ctx, 'ablauf', res.right.length ? `${res.right.length} Team(s) richtig – ${teamName(db, r.accepted)} −1` : `Niemand richtig – ${teamName(db, r.accepted)} +2`);
+      effect(db, 'reveal');
