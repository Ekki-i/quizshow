diff --git a/server/play-filmab.js b/server/play-filmab.js
new file mode 100644
index 0000000..0c448b7
--- /dev/null
+++ b/server/play-filmab.js
@@ -0,0 +1,141 @@
+'use strict';
+
+// Spiel „Film ab – Buzzer an!“: Die Moderation startet den Filmausschnitt auf
+// dem Beamer, alle Teams dürfen buzzern. Der erste Buzzer antwortet mündlich:
+// richtig = 1 Punkt und der Film endet, falsch = dieses Team ist für diesen Film
+// gesperrt, der Clip läuft noch einmal von vorn und die übrigen dürfen erneut buzzern.
+
+const { fail, log, effect, teamName, teamIds, bookTarget, buzzIn, currentBuzz, buzzTeamView } = require('./core');
+
+function round(st, i) {
+  if (!st.rounds[i]) st.rounds[i] = { started: false, playback: { state: 'stopped', seq: 0, restart: true }, buzzes: [], locked: [], resolved: false, winner: null };
+  return st.rounds[i];
+}
+
+function current(st) {
+  if (st.index < 0) fail('Es läuft gerade kein Film.');
+  return round(st, st.index);
+}
+
+function setPlayback(r, state, restart = false) {
+  r.playback = { state, seq: r.playback.seq + 1, restart };
+}
+
+module.exports = {
+  init: () => ({ index: -1, rounds: {} }),
+
+  team: {
+    buzz(db, ctx, game, st) {
+      const r = current(st);
+      if (!r.started) fail('Der Film läuft noch nicht.');
+      if (currentBuzz(r)) fail('Ein anderes Team antwortet gerade.');
+      buzzIn(db, ctx, r);
+      // Beim Buzzer hält der Clip an, damit in Ruhe geantwortet werden kann.
+      if (r.playback.state === 'playing') setPlayback(r, 'paused');
+    },
+  },
+
+  mod: {
+    open(db, ctx, game, st, p) {
+      const i = Number(p.index);
+      if (!game.content.films[i]) fail('Film nicht gefunden.');
+      if (st.index >= 0 && st.index !== i) {
+        const prev = round(st, st.index);
+        if (prev.playback.state === 'playing') setPlayback(prev, 'stopped');
+      }
+      st.index = i;
+      round(st, i);
+      log(db, ctx, 'ablauf', `Film ${i + 1} vorbereitet`);
+    },
+
+    // Abspielen: von vorn oder an der Pausenstelle weiter.
+    play(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!game.content.films[st.index].clip) fail('Für diesen Film ist noch kein Ausschnitt hochgeladen.');
+      if (currentBuzz(r)) fail('Erst die Antwort des Teams bewerten.');
+      r.started = true;
+      setPlayback(r, 'playing', !!p.restart || r.playback.state === 'stopped');
+      log(db, ctx, 'ablauf', `Film ${st.index + 1} läuft${p.restart ? ' (von vorn)' : ''}`);
+      effect(db, 'title');
+    },
+
+    pause(db, ctx, game, st) {
+      const r = current(st);
+      setPlayback(r, 'paused');
+    },
+
+    judge(db, ctx, game, st, p) {
+      const r = current(st);
+      const b = currentBuzz(r);
+      if (!b) fail('Gerade antwortet kein Team.');
+      const film = game.content.films[st.index];
+      if (p.correct) {
+        b.status = 'correct';
+        r.resolved = true;
+        r.winner = b.teamId;
+        setPlayback(r, 'stopped');
+        bookTarget(db, ctx, `filmab:${game.id}:${st.index}`, b.teamId, 1, `${game.title}, Film ${st.index + 1}`);
+        log(db, ctx, 'bewertung', `${teamName(db, b.teamId)}: „${film.title}“ richtig`);
+        effect(db, 'correct');
+      } else {
+        b.status = 'wrong';
+        r.locked.push(b.teamId);
+        log(db, ctx, 'bewertung', `${teamName(db, b.teamId)}: falsch, für diesen Film gesperrt`);
+        effect(db, 'wrong');
+        if (teamIds(db).every((id) => r.locked.includes(id))) {
+          r.resolved = true;
+          setPlayback(r, 'stopped');
+          log(db, ctx, 'ablauf', `Film ${st.index + 1}: alle Teams falsch, keine Punkte`);
+        } else {
+          // Clip läuft noch einmal von vorn; alle nicht gesperrten Teams dürfen wieder buzzern.
+          setPlayback(r, 'playing', true);
+          log(db, ctx, 'ablauf', `Film ${st.index + 1} läuft noch einmal von vorn`);
+        }
+      }
+    },
+
+    // Film manuell beenden (z. B. niemand weiß es); die Lösung wird gezeigt.
+    close(db, ctx, game, st) {
+      const r = current(st);
+      if (currentBuzz(r)) fail('Erst die Antwort des Teams bewerten.');
+      r.resolved = true;
+      setPlayback(r, 'stopped');
+      log(db, ctx, 'ablauf', `Film ${st.index + 1} beendet`);
+    },
+  },
+
+  teamView(db, game, st, teamId) {
+    if (st.index < 0) return null;
+    const r = round(st, st.index);
+    const pending = currentBuzz(r);
+    return {
+      index: st.index,
+      count: game.content.films.length,
+      started: r.started,
+      ...buzzTeamView(r, teamId),
+      resolved: r.resolved,
+      canBuzz: r.started && !r.resolved && !pending && !r.locked.includes(teamId) && !r.buzzes.some((b) => b.teamId === teamId && b.status === 'pending'),
+      someoneAnswering: !!pending && pending.teamId !== teamId,
+      title: r.resolved ? game.content.films[st.index].title : null,
+      winner: r.winner,
+    };
+  },
+
+  beamerView(db, game, st) {
+    if (st.index < 0) return { waiting: true };
+    const r = round(st, st.index);
+    const film = game.content.films[st.index];
+    const pending = currentBuzz(r);
+    return {
+      index: st.index,
+      clip: film.clip ? { id: film.clip.id, type: film.clip.type } : null,
+      playback: r.playback,
+      started: r.started,
+      answering: pending ? pending.teamId : null,
+      buzzOrder: r.buzzes.map((b) => ({ teamId: b.teamId, status: b.status })),
+      resolved: r.resolved,
+      title: r.resolved ? film.title : null,
+      winner: r.winner,
+    };
+  },
+};
diff --git a/server/play-fragen.js b/server/play-fragen.js
new file mode 100644
index 0000000..a212285
--- /dev/null
+++ b/server/play-fragen.js
@@ -0,0 +1,201 @@
+'use strict';
+
+// Spiel „Habt ihr noch Fragen?“: Zur Kategorie schreibt jedes Team eine
+// allgemeingültige Frage samt richtiger Antwort (zwei Schreibfelder) und schickt
+// beides per Buzzer ab – andere Teams bleiben frei. Die Moderation prüft in
+// Buzzer-Reihenfolge, lehnt unzulässige Vorschläge ab und gibt eine Frage frei.
+// Auf dem Beamer erscheint nur die Frage. Die anderen Teams haben 20 Sekunden.
+// Mindestens ein Team richtig: jedes richtige Team +1, fragendes Team −1.
+// Niemand richtig: fragendes Team +2.
+
+const { fail, log, effect, teamName, teamIds, bookTarget, cleanInk } = require('./core');
+
+function secondsOf(game) {
+  const n = Number(game.content.seconds);
+  return Number.isFinite(n) && n >= 5 ? n : 20;
+}
+
+function round(st, c) {
+  if (!st.rounds[c]) st.rounds[c] = { open: false, subs: [], accepted: null, published: false, deadline: null, answers: {}, grades: {}, showAnswers: false, showSolution: false, evaluated: false };
+  return st.rounds[c];
+}
+
+function current(st) {
+  if (st.catIndex < 0) fail('Es läuft gerade keine Kategorie.');
+  return round(st, st.catIndex);
+}
+
+const GRACE_MS = 1500; // Netzwerk-Puffer für Abgaben in der letzten Sekunde
+
+function result(r) {
+  const right = Object.keys(r.answers).filter((id) => r.grades[id] === true);
+  return { right, askerPoints: right.length ? -1 : 2 };
+}
+
+module.exports = {
+  init: () => ({ catIndex: -1, rounds: {} }),
+  result,
+
+  team: {
+    propose(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.open || r.published) fail('Gerade werden keine Fragen angenommen.');
+      if (r.subs.some((s) => s.teamId === ctx.teamId)) fail('Ihr habt schon einen Vorschlag abgeschickt.');
+      const q = cleanInk(p.qInk);
+      const a = cleanInk(p.aInk);
+      if (!q || !a) fail('Bitte Frage UND richtige Antwort aufschreiben.');
+      r.subs.push({ teamId: ctx.teamId, qInk: q, aInk: a, at: ctx.now, status: 'pending' });
+      log(db, ctx, 'buzzer', `${teamName(db, ctx.teamId)} schickt einen Vorschlag (Platz ${r.subs.length})`);
+      effect(db, 'buzz');
+    },
+
+    answer(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.published) fail('Noch ist keine Frage freigegeben.');
+      if (r.accepted === ctx.teamId) fail('Eure eigene Frage beantwortet ihr nicht.');
+      if (r.answers[ctx.teamId]) fail('Ihr habt schon geantwortet.');
+      if (r.deadline && ctx.now > r.deadline + GRACE_MS) fail('Die Zeit ist abgelaufen.');
+      const ink = cleanInk(p.ink);
+      if (!ink) fail('Bitte zuerst die Antwort aufschreiben.');
+      r.answers[ctx.teamId] = { ink, at: ctx.now };
+      log(db, ctx, 'antwort', `${teamName(db, ctx.teamId)} hat geantwortet`);
+    },
+  },
+
+  mod: {
+    open(db, ctx, game, st, p) {
+      const c = Number(p.catIndex);
+      if (!game.content.categories[c]) fail('Kategorie nicht gefunden.');
+      if (st.catIndex >= 0 && st.catIndex !== c) {
+        const prev = round(st, st.catIndex);
+        if (prev.published && !prev.evaluated) fail('Erst die laufende Frage auswerten.');
+        prev.open = false;
+      }
+      st.catIndex = c;
+      const r = round(st, c);
+      if (!r.evaluated) r.open = true;
+      log(db, ctx, 'ablauf', `Kategorie „${game.content.categories[c].name}“: Vorschläge offen`);
+      effect(db, 'title');
+    },
+
+    reject(db, ctx, game, st, p) {
+      const r = current(st);
+      const s = r.subs.find((x) => x.teamId === p.teamId);
+      if (!s || r.published) fail('Diesen Vorschlag gibt es nicht (mehr).');
+      s.status = 'rejected';
+      s.reason = typeof p.reason === 'string' ? p.reason.slice(0, 80) : '';
+      log(db, ctx, 'bewertung', `Vorschlag von ${teamName(db, p.teamId)} abgelehnt${s.reason ? ` (${s.reason})` : ''}`);
+    },
+
+    accept(db, ctx, game, st, p) {
+      const r = current(st);
+      const s = r.subs.find((x) => x.teamId === p.teamId && x.status !== 'rejected');
+      if (!s || r.published) fail('Diesen Vorschlag gibt es nicht (mehr).');
+      for (const x of r.subs) if (x.status === 'accepted') x.status = 'pending';
+      s.status = 'accepted';
+      r.accepted = s.teamId;
