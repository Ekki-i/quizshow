+.fx-q { margin: 0 !important; height: 12.4vh; min-height: 0; padding: 0 5vh; box-sizing: border-box; display: grid; grid-template-rows: 6vh 6.4vh; align-items: center; gap: 0; background: #1e1e20; z-index: 1; }
