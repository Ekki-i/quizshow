+.beamer .answer .ink-answer.beamer { height: 20vh; width: auto; max-width: 100%; margin-top: 0.6vh; object-fit: contain; }
+
+/* Spiel 5 „5 ist Trümpf“: kompakt, passt mit allen Hinweisen auf den Beamer */
+.beamer .t5 { display: flex; flex-direction: column; align-items: center; gap: 1.6vh; width: 100%; }
+.beamer .t5-cat { font-weight: 800; text-transform: uppercase; line-height: 1; font-size: clamp(1.2rem, min(4.4vw, 7vh), 4.6rem); text-shadow: var(--glow); }
+.beamer .t5-cat small { display: block; font-size: 0.3em; letter-spacing: 0.14em; color: var(--accent-3); margin-bottom: 0.5em; text-shadow: none; }
+.beamer .t5 .hints { width: 100%; max-width: min(86vw, 150vh); gap: 0.9vh; }
+.beamer .t5 .hints li { display: flex; align-items: center; gap: 1.1vw; font-family: var(--font); font-weight: 600; letter-spacing: 0.005em; line-height: 1.15; font-size: clamp(0.85rem, min(2.4vw, 3.9vh), 2.7rem); padding: 1.1vh 1.6vw; min-height: 7.2vh; background: linear-gradient(90deg, rgba(23, 25, 58, 0.96), rgba(39, 42, 88, 0.9)); border-left: 0.5vw solid var(--accent); text-wrap: pretty; }
+.beamer .t5 .hints li .pv { flex: none; width: 2em; height: 2em; border-radius: 50%; display: grid; place-items: center; background: var(--accent-2); color: #1a0f00; font-family: var(--font-display); font-weight: 800; font-size: 0.78em; }
+.beamer .t5 .hints li.empty { background: rgba(23, 25, 58, 0.45); border-left-color: rgba(255, 255, 255, 0.15); animation: none; }
+.beamer .t5 .hints li.empty .pv { background: rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.5); }
+.beamer .t5-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.2vw; }
+.beamer .t5-foot .row { margin-top: 0 !important; }
+.beamer .t5-value { font-weight: 700; font-size: clamp(0.8rem, min(1.8vw, 3vh), 2rem); color: var(--text-muted); }
+.beamer .t5 .solution { margin-top: 0.4vh; font-size: clamp(1rem, min(3vw, 5.2vh), 3.4rem); padding: 1vh 2.4vw; }
+.beamer .t5 .chip { font-size: clamp(0.8rem, min(1.6vw, 2.8vh), 1.8rem); }
+
+/* Fragen-Banner: dunkle Box mit grauen Dreiecken links und rechts, die nach
+   innen zeigen; hebt die Frage klar vom Bühnenhintergrund ab. */
+.beamer .q {
+  --tri: clamp(3rem, 9vh, 7.5rem);
+  position: relative; width: min(92vw, 160vh); margin: 0 auto 3vh; box-sizing: border-box;
+  min-height: calc(var(--tri) * 1.4); display: flex; align-items: center; justify-content: center;
+  padding: 2.2vh calc(var(--tri) * 1.35);
+  background: #201f22; color: #fff; text-shadow: none;
+  font-family: var(--font); font-weight: 500; letter-spacing: 0.01em; line-height: 1.2;
+  font-size: clamp(1rem, min(2.6vw, 4.4vh), 2.8rem); text-wrap: balance;
+  box-shadow: 0 1.2vh 3vh rgba(0, 0, 0, 0.55);
+  animation: qIn calc(0.45s * var(--speed)) ease-out both;
+}
+.beamer .q::before, .beamer .q::after {
+  content: ""; position: absolute; top: 0; bottom: 0; width: var(--tri); background: #444446;
+}
+.beamer .q::before { left: 0; clip-path: polygon(0 0, 100% 50%, 0 100%); }
+.beamer .q::after { right: 0; clip-path: polygon(100% 0, 0 50%, 100% 100%); }
+.beamer .q.compact { --tri: clamp(2.6rem, 7.5vh, 6.2rem); font-size: clamp(0.95rem, min(2.3vw, 3.9vh), 2.5rem); margin-bottom: 2vh; padding-top: 1.6vh; padding-bottom: 1.6vh; }
+.beamer .q.finale { color: var(--accent-2); }
+@keyframes qIn { from { opacity: 0; transform: scaleX(0.92); } to { opacity: 1; transform: none; } }
+
+/* Antwortmöglichkeiten (Spiel 2, 7 …) im Stil des Fragen-Banners:
+   dunkle Box, graues Dreieck außen – links in der linken, rechts in der
+   rechten Spalte, wie beim Banner gespiegelt. */
+.beamer .options { width: min(92vw, 160vh); max-width: none; gap: 1.6vh 1.6vw; }
+.beamer .opt {
+  --tri: clamp(1.8rem, 5.2vh, 4.2rem);
+  position: relative; overflow: hidden; border: 0; border-radius: 0;
+  min-height: calc(var(--tri) * 1.4); padding: 1.4vh 1.6vw 1.4vh calc(var(--tri) * 1.25);
+  background: #201f22; color: #fff; box-shadow: 0 0.8vh 2vh rgba(0, 0, 0, 0.5);
+  font-family: var(--font); font-weight: 500; letter-spacing: 0.01em; line-height: 1.15;
+  font-size: clamp(0.95rem, min(2.2vw, 3.7vh), 2.4rem);
+  animation: qIn calc(0.4s * var(--speed)) ease-out both;
+}
+.beamer .opt:nth-child(2) { animation-delay: 0.08s; }
+.beamer .opt:nth-child(3) { animation-delay: 0.16s; }
+.beamer .opt:nth-child(4) { animation-delay: 0.24s; }
+.beamer .opt::before { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: var(--tri); background: #444446; clip-path: polygon(0 0, 100% 50%, 0 100%); transition: background 0.3s; }
+.beamer .opt:nth-child(even) { padding-left: 1.6vw; padding-right: calc(var(--tri) * 1.25); }
+.beamer .opt:nth-child(even)::before { left: auto; right: 0; clip-path: polygon(100% 0, 0 50%, 100% 100%); }
+.beamer .opt b { font-family: var(--font-display); font-weight: 800; color: var(--accent-2); min-width: 1.1em; }
+.beamer .opt.correct { background: #10462a; border: 0; box-shadow: 0 0 0 0.35vh var(--ok), 0 0 3vh rgba(43, 217, 107, 0.45); animation: pop 0.5s ease-out; }
+.beamer .opt.correct::before { background: var(--ok); }
+.beamer .opt.correct b { color: #b6ffd1; }
+.beamer .opt.dim { opacity: 0.4; }
+.beamer .options.compact .opt { --tri: clamp(1.6rem, 4.4vh, 3.6rem); padding-top: 1vh; padding-bottom: 1vh; font-size: clamp(0.9rem, min(2vw, 3.3vh), 2.2rem); }
+
+/* Editor: 3D-Avatar je Team */
+.visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
+.avatar-cell { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.avatar-cell label.btn { cursor: pointer; margin: 0; font-weight: 700; }
+.avatar-thumb { width: 44px; height: 56px; object-fit: contain; background: radial-gradient(circle at 50% 40%, var(--surface-2), var(--bg)); border-radius: 8px; }
+.avatar-empty { width: 44px; height: 56px; display: inline-grid; place-items: center; color: var(--text-muted); border: 2px dashed var(--surface-2); border-radius: 8px; }
+
+/* Gezeichnete Teampulte */
+.scene-teams .podiums { display: block; width: 100%; height: auto; overflow: visible; border-radius: 1vh; }
+.podium { animation: podiumIn calc(0.6s * var(--speed)) cubic-bezier(.2,1.2,.4,1) both; transform-box: fill-box; transform-origin: 50% 100%; }
+.podium-name { font-family: var(--font-display); font-weight: 800; letter-spacing: 0.03em; fill: #fff; stroke: #07081a; stroke-width: 4.5; stroke-linejoin: round; paint-order: stroke fill; filter: drop-shadow(0 0 5px var(--team)); }
+.podium-name.winner { fill: var(--accent-2); }
+.podium-points { font-family: var(--font-display); font-weight: 800; fill: #fff; font-variant-numeric: tabular-nums; }
+.podium-points.winner { fill: var(--accent-2); }
+.podium-score.winner { filter: drop-shadow(0 0 8px #ffc23d); }
+.podium-avatar { animation: avatarIn calc(0.7s * var(--speed)) ease-out both; animation-delay: inherit; }
+@keyframes podiumIn { from { opacity: 0; transform: translateY(12%) scale(0.92); } to { opacity: 1; transform: none; } }
+@keyframes avatarIn { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
+
+/* Pause mit Live-Band */
+.band-scene { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; }
+.band-scene .band-svg { width: 100%; height: 100%; }
+.band-scene .bd-lights polygon { opacity: calc(0.08 + var(--kick, 0) * 0.22); mix-blend-mode: screen; }
+.band-scene .bd-pause { font-family: var(--font-display); font-weight: 800; font-size: 64px; letter-spacing: 0.06em; fill: #fff; filter: drop-shadow(0 0 calc(4px + var(--beat, 0) * 14px) #ff2d8a); }
+.band-scene .bd-pause-sub { font-family: var(--font); font-weight: 600; font-size: 18px; fill: #b9bde0; letter-spacing: 0.04em; }
+
+/* Teampulte aus dem Show-Bild */
+.scene-teams { width: min(94vw, 165vh); }
+.podium-slot { animation: logoIn calc(0.5s * var(--speed)) ease-out both; }
+.podium-slot .podium-avatar { animation: avatarIn calc(0.7s * var(--speed)) ease-out both; }
+.podium-name { stroke-width: 4; }
+
+/* Showablauf als Präsentation (Live-Regie) */
+#run-panel { margin-bottom: 16px; }
+.run-card h3 { margin-bottom: 8px; }
+.run-head { display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
+.run-now { min-width: 0; flex: 1 1 340px; }
+.run-count { font-weight: 700; color: var(--accent-3); font-size: 0.9rem; letter-spacing: 0.04em; text-transform: uppercase; }
+.run-title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.2rem, 2.4vw, 1.8rem); line-height: 1.2; margin: 4px 0; display: flex; gap: 10px; align-items: center; }
+.run-ico { font-size: 1.1em; }
+.run-buttons { display: flex; gap: 10px; }
+.run-go { min-width: 200px; font-size: 1.25rem; min-height: 64px; }
+.run-strip { list-style: none; margin: 14px 0 0; padding: 4px 2px 10px; display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x proximity; }
+.run-strip li { flex: none; scroll-snap-align: center; display: flex; }
+.run-step { width: 132px; height: 84px; display: grid; grid-template-rows: auto 1fr; grid-template-columns: auto 1fr; gap: 2px 6px; align-content: start; text-align: left; padding: 8px; border-radius: var(--radius-sm); border: 2px solid var(--surface-2); background: var(--bg); color: var(--text); cursor: pointer; font: 600 0.78rem/1.2 var(--font); }
+.run-step .n { font-weight: 800; color: var(--text-muted); }
+.run-step .i { justify-self: end; }
+.run-step .t { grid-column: 1 / -1; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
+.run-step.done { opacity: 0.45; }
+.run-step.current { border-color: var(--accent); background: #3a0f2b; box-shadow: 0 0 0 3px rgba(255, 45, 138, 0.35); }
+.run-step.k-coin { border-top: 4px solid var(--gold); }
+.run-step.k-pause { border-top: 4px solid var(--accent-3); }
+.run-step.k-title, .run-step.k-game { border-top: 4px solid var(--salmon); }
+.run-step:focus-visible { outline: 3px solid var(--accent-3); outline-offset: 2px; }
+.run-hint { margin: 6px 0 0; font-size: 0.85rem; }
+.live-restart { display: flex; justify-content: flex-end; margin-bottom: 48px; }
+.btn.bad-text { color: var(--bad, #e5484d); }
+/* Ablauf im Show-Editor */
+.rundown-list { max-height: 520px; overflow: auto; }
+.rundown-list .rd-n { min-width: 2.2em; color: var(--text-muted); }
+.rundown-list .rd.k-coin { border-left: 4px solid var(--gold); }
+.rundown-list .rd.k-pause { border-left: 4px solid var(--accent-3); }
+.rundown-list .rd.k-title, .rundown-list .rd.k-game { border-left: 4px solid var(--salmon); }
+.rundown-list .btn.small { min-height: 32px; padding: 4px 10px; }
+
+/* Intro-Video */
+.video-stage { position: fixed; inset: 0; background: #000; display: flex; align-items: center; justify-content: center; z-index: 5; }
+.video-stage .intro-video { width: 100%; height: 100%; object-fit: contain; background: #000; }
+.video-stage .video-end { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; animation: logoIn calc(0.6s * var(--speed)) ease-out both; }
+.video-stage:has(.video-end) { background: transparent; }
+
+.intro-box { display: grid; gap: 8px; }
+.intro-preview { width: 100%; max-width: 560px; aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius-sm); }
+
+/* Beamer: Vollbild-Steuerung */
+.beamer-controls { position: fixed; left: max(12px, env(safe-area-inset-left)); bottom: max(12px, env(safe-area-inset-bottom)); z-index: 60; display: flex; gap: 8px; transition: opacity 0.4s; }
+body.beamer-page.is-idle .beamer-controls { opacity: 0; pointer-events: none; }
+body.beamer-page.is-idle, body.beamer-page.is-idle * { cursor: none !important; }
+body.beamer-page.is-fullscreen .conn { opacity: 0; transition: opacity 0.4s; }
+body.beamer-page.is-fullscreen:not(.is-idle) .conn { opacity: 1; }
+.fs-hint { position: fixed; left: 50%; top: 50%; translate: -50% -50%; z-index: 100; max-width: min(92vw, 520px); background: var(--surface); border: 2px solid var(--accent); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow); text-align: left; }
+.fs-hint p { margin: 8px 0 12px; color: var(--text-muted); }
+
+.beamer-url code { font-family: ui-monospace, Menlo, Consolas, monospace; background: var(--bg); padding: 6px 10px; border-radius: var(--radius-sm); overflow-wrap: anywhere; }
+.beamer-url .notice { font-size: 0.85rem; }
+
+/* Kleine Beamer-Vorschau unter dem Showablauf */
+.beamer-mini { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 16px; }
+.beamer-mini .preview { width: min(100%, 400px); flex: none; box-shadow: 0 0 0 2px var(--surface-2); }
+.beamer-mini-info { flex: 1 1 260px; min-width: 0; }
+.beamer-mini-info h3 { margin-bottom: 6px; }
+
+/* Lieder je Pause im Editor */
+.rundown-list li.rd { flex-wrap: wrap; }
+.pause-songs { flex: 1 1 100%; margin: 6px 0 2px 2.2em; padding: 12px; border-radius: var(--radius-sm); background: rgba(31, 214, 242, 0.07); border: 1px solid rgba(31, 214, 242, 0.35); }
+.pause-songs p { margin: 0 0 8px; }
+.song-list { list-style: none; margin: 0 0 10px; padding: 0; display: grid; gap: 6px; }
+.song-list li { display: flex; align-items: center; gap: 8px; background: var(--bg); border-radius: var(--radius-sm); padding: 6px 10px; }
+.song-list .grow { flex: 1; min-width: 0; overflow-wrap: anywhere; }
+
+/* ==========================================================================
+   Show-Studio als Hintergrund für alle Seiten (Moderation, Team-iPads, Start)
+   ========================================================================== */
