+.fx-q span { font-size: clamp(0.7rem, 2.1vh, 1.6rem); font-weight: 500; line-height: 1.15; border-bottom: 0.3vh solid #3a3a3c; height: 100%; display: flex; align-items: center; justify-content: center; }
+.fx-q b { font-size: clamp(0.8rem, 3vh, 2.2rem); }
+.fx-q em { position: absolute; bottom: 0.4vh; left: 0; right: 0; font-size: 1.5vh; }
+.fx-q.no-answer { grid-template-rows: 12.4vh; }
+.fx-q.no-answer span { border-bottom: 0; }
+.fx-mid .fx-q { align-self: stretch; margin: 0 -0.6vw !important; }
+.fx-q b { display: flex; align-items: center; justify-content: center; gap: 1vw; }
+.fx-q em { position: static; font-size: 1.7vh; }
+.fx-q span { font-size: clamp(0.75rem, 2.6vh, 1.9rem); }
+/* Frage und Lösung dürfen sich nie überschneiden: Frage oben (kleiner, darf zweizeilig sein), Lösung in fester Zeile darunter */
+.fx-q { grid-template-rows: minmax(0, 1fr) 4.8vh; padding-top: 0.6vh; padding-bottom: 0.6vh; }
+.fx-q span { font-size: clamp(0.65rem, 2.1vh, 1.5rem); line-height: 1.12; overflow: hidden; height: auto; min-height: 0; padding-bottom: 0.4vh; }
+.fx-q.long span { font-size: clamp(0.6rem, 1.8vh, 1.3rem); }
+.fx-q b { font-size: clamp(0.75rem, 2.6vh, 1.9rem); line-height: 1; overflow: hidden; }
+.fx-q.no-answer span { font-size: clamp(0.7rem, 2.5vh, 1.8rem); }
+/* Finale skaliert nur mit der Bildhöhe (keine Mindestgrößen), damit auch die kleine
+   Beamer-Vorschau und jedes Leinwandformat dieselben Proportionen haben. */
+.fb-stage.fx .fx-name { font-size: 3.2vh; }
+.fb-stage.fx .fx-q span { font-size: 2.1vh; }
+.fb-stage.fx .fx-q.long span { font-size: 1.8vh; }
+.fb-stage.fx .fx-q.no-answer span { font-size: 2.5vh; }
+.fb-stage.fx .fx-q b { font-size: 2.6vh; }
+.fb-stage.fx .fx-q em { font-size: 1.7vh; }
+.fb-stage.fx .fx-board-body, .fb-stage.fx .fx-face { font-size: 5vh; }
+.fb-stage.fx .fx-locked { font-size: 3vh; }
+.fb-stage.fx .fx-nocoin { font-size: 1.6vh; }
+.fb-stage.fx .fx-board { overflow: hidden; }
+.fb-stage.fx .fx-board-body, .fb-stage.fx .fx-face { inset: 1vh 1vw; }
+.fb-stage.fx .fx-q span, .fb-stage.fx .fx-q b, .fb-stage.fx .fx-name { overflow: hidden; white-space: normal; }
+.fb-stage.fx .fx-name { white-space: nowrap; }
+/* Avatar hinter dem Finalpult: an das Studiolicht angepasst */
+.pult-av img { filter: brightness(0.9) contrast(1.04) saturate(0.95) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5)); }
+/* Handschrift groß und kräftig, vollständig sichtbar */
+.fb-stage.fx .fx-ink { width: 100%; height: 100%; max-width: none; max-height: none; object-fit: contain; filter: url(#ink-bold) invert(1); mix-blend-mode: screen; background: transparent !important; border-radius: 0; }
+.fb-stage.fx .fx-board { overflow: visible; }
+.fb-stage.fx .fx-ink { width: 100%; height: 100%; object-fit: contain; filter: none; mix-blend-mode: normal; background: transparent !important; }
+.fb-stage.fx .fx-side .fb-stamp { top: -2vh; right: -2vh; width: 9vh; height: 9vh; font-size: 5.6vh; z-index: 5; }
+.game-intro { position: fixed; width: 1px; height: 1px; opacity: 0; pointer-events: none; left: -10px; top: -10px; }
+.game-intro-box { margin: 12px 0; padding: 12px 14px; border-radius: var(--radius-sm); background: var(--surface-2); border-left: 4px solid var(--accent-2); }
+.game-intro-preview { width: 100%; max-height: 180px; margin: 6px 0; }
+.list.leader li { gap: 8px; }
+.list.leader .rank-n { width: 1.6em; color: var(--text-muted); }
+.list.leader .pts { min-width: 3.4em; text-align: center; font-variant-numeric: tabular-nums; }
+.list.leader .pt-btn { padding: 4px 9px; min-width: 2.4em; }
+/* Spiel 2: Tauschpartner über die Teampulte wählen */
+.swap-podiums { margin-top: 12px; }
+.swap-podiums .scene-teams { width: 100%; }
+.podium-slot .pick-hit { fill: transparent; stroke: transparent; stroke-width: 4; }
+.podium-slot.pick { cursor: pointer; }
+.podium-slot.pick:hover .pick-hit, .podium-slot.pick:focus-visible .pick-hit { stroke: #fff; fill: rgba(255, 255, 255, 0.08); }
+.podium-slot.pick:active .pick-hit { fill: rgba(255, 255, 255, 0.2); }
+.podium-slot.pick { animation: pickPulse 1.6s ease-in-out infinite; }
+@keyframes pickPulse { 50% { filter: drop-shadow(0 0 8px var(--team)); } }
+.podium-slot.pick-off { filter: grayscale(1) brightness(0.45); opacity: 0.6; }
+.podium-slot:focus { outline: none; }
+.podium-slot .pick-veil { fill: rgba(8, 9, 20, 0.72); }
+.podium-slot.pick-off { filter: none; opacity: 1; }
+.podium-slot.pick-off .podium-name { fill: #777; filter: none; }
+.list.leader li { flex-wrap: nowrap; gap: 5px; }
+.list.leader .grow { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.list.leader .badge { padding: 2px 6px; }
+.list.leader .pt-btn { padding: 3px 7px; min-width: 0; min-height: 0; font-size: 0.85rem; }
+.list.leader .pts { min-width: 2.8em; }
+/* Spiele ohne Mülleimer-Spalte; Unterpunkte des Show-Editors */
+.board { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+.tabs.editor-sections { margin: 4px 0 16px; padding: 6px; border-radius: var(--radius); background: rgba(20, 22, 52, 0.84); border: 1px solid rgba(255, 255, 255, 0.07); }
+.tabs.editor-sections button { font-size: 1rem; }
+
+/* Spieltitel des Finales: Studio-Bildschirm groß, kupferfarbenes Finale-Design */
+.ft-stage { position: fixed; inset: 0; z-index: 1; overflow: hidden; background: #05060f; }
+.ft-zoom { position: absolute; width: 255vw; left: calc(50vw - 128.8vw); top: calc(47vh - 26.1vw); container-type: inline-size; animation: ftZoom calc(2.4s * var(--speed)) cubic-bezier(.2,.8,.2,1) both; transform-origin: 50% 18%; }
+@keyframes ftZoom { from { transform: scale(0.42); filter: brightness(0.6); } to { transform: none; filter: none; } }
+.ft-zoom > .ft-room { display: block; width: 100%; height: auto; aspect-ratio: 938 / 530; }
+.ft-screen { position: absolute; overflow: hidden; background: #b35f32; box-shadow: inset 0 0 1.2cqw rgba(0, 0, 0, 0.35); }
+.ft-box { position: absolute; left: 16%; right: 16%; top: 33%; bottom: 33%; display: flex; align-items: center; justify-content: center; background: #93502b; box-shadow: 0 0 0.6cqw rgba(0, 0, 0, 0.25); animation: ftBox calc(0.8s * var(--speed)) calc(0.3s * var(--speed)) cubic-bezier(.2,1.3,.4,1) both; }
+@keyframes ftBox { from { transform: scaleX(0); } to { transform: none; } }
+.ft-big { display: flex; font-family: var(--font-display); font-weight: 900; font-size: 3.7cqw; letter-spacing: 0.02em; color: #0d0a08; -webkit-text-stroke: 0.04cqw #f2e6dc; paint-order: fill stroke; line-height: 1; }
+.ft-big span { display: inline-block; animation: letterDrop calc(0.6s * var(--speed)) cubic-bezier(.2,1.5,.4,1) both; }
+.ft-edge { position: absolute; display: flex; align-items: center; justify-content: center; overflow: hidden; }
+.ft-edge.top { left: 0; right: 0; top: 4%; height: 14%; }
+.ft-edge.bottom { left: 0; right: 0; bottom: 4%; height: 14%; }
+.ft-edge.left { top: 0; bottom: 0; left: 3%; width: 9%; }
+.ft-edge.right { top: 0; bottom: 0; right: 3%; width: 9%; }
+.ft-run { display: flex; gap: 2.4cqw; white-space: nowrap; font-family: var(--font-display); font-weight: 900; font-size: 1.55cqw; letter-spacing: 0.05em; line-height: 1; transform: rotate(var(--rot)); }
+.ft-edge.top .ft-run, .ft-edge.bottom .ft-run { color: #fff; text-shadow: 0.06em 0.06em 0 #3a1c0c; animation: ftRunX calc(14s * var(--speed)) linear infinite; }
+.ft-edge.left .ft-run, .ft-edge.right .ft-run { color: #0d0a08; animation: ftRunX calc(14s * var(--speed)) linear infinite; }
+@keyframes ftRunX { from { translate: -18% 0; } to { translate: 18% 0; } }
+.ft-edge .ft-run { opacity: 0; animation-delay: 0s; }
+.ft-stage .ft-edge .ft-run { animation: ftRunX calc(14s * var(--speed)) linear infinite, ftFade calc(0.8s * var(--speed)) calc(1.2s * var(--speed)) ease-out both; }
+@keyframes ftFade { from { opacity: 0; } to { opacity: 1; } }
+@keyframes ftRunY { from { translate: 0 -18%; } to { translate: 0 18%; } }
+.ft-stage .ft-edge.left .ft-run, .ft-stage .ft-edge.right .ft-run { animation: ftRunY calc(14s * var(--speed)) linear infinite, ftFade calc(0.8s * var(--speed)) calc(1.2s * var(--speed)) ease-out both; }
+.ft-stage .ft-edge.top .ft-run { animation-direction: reverse, normal; }
+.ft-stage .ft-edge.right .ft-run { animation-direction: reverse, normal; }
+/* Gewinnstufen-Spieltitel: blauer Screen, große schwarze Zahl, ringsum „GEWINNSTUFE“ */
+.ft-stagecol .ft-screen { background: var(--stage, #1d9bf5); box-shadow: inset 0 0 0 0.45cqw color-mix(in srgb, var(--stage, #1d9bf5) 55%, #000), inset 0 0 1.2cqw rgba(0, 0, 0, 0.35); }
+.ft-stagecol .ft-box { background: none; box-shadow: none; left: 14%; right: 14%; top: 20%; bottom: 20%; }
+.ft-stagecol .ft-big.num { font-size: 9.5cqw; color: #050608; -webkit-text-stroke: 0; text-shadow: 0.08cqw 0.08cqw 0.25cqw rgba(0, 0, 0, 0.45); font-stretch: condensed; transform: scaleX(0.8); }
+.ft-stagecol .ft-run { font-size: 1.15cqw; }
+.ft-stagecol .ft-edge.top .ft-run, .ft-stagecol .ft-edge.bottom .ft-run { color: #fff; text-shadow: none; -webkit-text-stroke: 0.035cqw #050608; paint-order: stroke fill; }
+.ft-stagecol .ft-edge.left .ft-run, .ft-stagecol .ft-edge.right .ft-run { color: #050608; -webkit-text-stroke: 0.03cqw #fff; paint-order: stroke fill; }
+.stage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
+.stage-cell { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--line, rgba(255,255,255,.15)); border-radius: 10px; }
+.stage-thumb { width: 48px; height: 48px; display: grid; place-items: center; background: #1d9bf5; color: #050608; font-weight: 900; font-size: 26px; border-radius: 6px; }
+
+/* Schriftzüge am Rand stehen wie im Studio-Design: je Seite ein ganzes Wort (oben kopfüber, links/rechts gedreht) */
+.ft-stage .ft-edge .ft-run, .ft-stage .ft-edge.left .ft-run, .ft-stage .ft-edge.right .ft-run { animation: ftFade calc(0.8s * var(--speed)) calc(1.2s * var(--speed)) ease-out both; font-size: 2cqw; }
+.ft-stage .ft-edge.top { top: 3%; height: 16%; }
+.ft-stage .ft-edge.bottom { bottom: 3%; height: 16%; }
+.ft-stage .ft-edge.left { left: 2%; width: 12%; }
+.ft-stage .ft-edge.right { right: 2%; width: 12%; }
+.ft-stagecol .ft-edge .ft-run, .ft-stagecol .ft-edge.left .ft-run, .ft-stagecol .ft-edge.right .ft-run { font-size: 1.3cqw; }
+.ft-stagecol .ft-big.num { font-size: 6.5cqw; }
+.ft-stage .ft-edge.top .ft-run, .ft-stage .ft-edge.right .ft-run { animation-direction: normal; }
+.ft-stage .ft-edge.left .ft-run, .ft-stage .ft-edge.right .ft-run { writing-mode: vertical-rl; }
+.ft-stage .ft-edge.left .ft-run { transform: none; }
+.ft-stage .ft-edge.right .ft-run { transform: rotate(180deg); }
+.ft-finale .ft-big { font-size: 2.5cqw; }
+.ft-stage .ft-edge.top .ft-run { transform: rotate(180deg); }
+.beamer .nerd-possible { margin-top: 1.4vh; font-size: 2.6vh; color: var(--muted, #c9c3e6); letter-spacing: .02em; }
+.beamer .nerd-possible b { color: var(--yellow, #ffc23d); font-size: 1.25em; }
+.beamer .named .chip.kept { opacity: .85; border-style: dashed; }
+
+/* Spieltitel: Rahmen ist immer eine dunklere Abstufung der Farbe in der Mitte */
+.tv { background: linear-gradient(color-mix(in srgb, var(--tv, var(--salmon)) 55%, #000), color-mix(in srgb, var(--tv, var(--salmon)) 30%, #000)); box-shadow: 0 0 0 0.5vh color-mix(in srgb, var(--tv, var(--salmon)) 70%, #000), 0 3vh 6vh rgba(0, 0, 0, 0.7); }
+.title-color { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 8px 0; }
+.title-color input[type=color] { width: 1px; height: 1px; opacity: 0; position: absolute; }
+.title-color label.btn { position: relative; }
+.title-swatch { width: 64px; height: 42px; border-radius: 6px; padding: 5px; background: color-mix(in srgb, var(--c) 55%, #000); box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 70%, #000); }
+.title-swatch span { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 3px; background: var(--c); color: #050608; font-weight: 900; font-size: 18px; }
+
+/* ===== Einheitlicher Look der Spielfolien: rechteckige graue Boxen wie im Finale
+   und beim Fragen-Banner; Teamfarben als Akzentbalken, Zahlen in Gelb. ===== */
+.beamer { --box: #201f22; --box-2: #2b2b2e; --box-edge: #444446; }
+.beamer .chip { border-radius: 0; background: var(--box); box-shadow: inset 0.5vh 0 0 var(--chip, var(--box-edge)), 0 0.6vh 1.6vh rgba(0, 0, 0, 0.45); padding: 0.55em 1em 0.55em 1.1em; font-family: var(--font); font-weight: 700; color: #fff; font-size: clamp(0.8rem, min(1.7vw, 3vh), 1.8rem); }
+.beamer .chip .dot { border-radius: 0; width: 0.5em; height: 1.4em; }
+.beamer .chip.answering { outline: none; box-shadow: inset 0 0 0 0.45vh var(--accent-2), 0 0 2.4vh rgba(255, 194, 61, 0.45); }
+.beamer .chip b { color: var(--accent-2); font-family: var(--font-display); }
+.beamer .solution { border-radius: 0; background: var(--box); color: #fff; font-family: var(--font); font-weight: 700; box-shadow: inset 0 -0.6vh 0 var(--ok), 0 1vh 2.4vh rgba(0, 0, 0, 0.5); font-size: clamp(1rem, min(2.6vw, 4.6vh), 3rem); }
+.beamer .sub { font-weight: 600; }
+
+/* Spiel 1: Antwortkarten wie die Finalpulte – passt für 6 Teams (3 × 2) */
+.beamer .answers { width: min(94vw, 165vh); margin: 0 auto; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.8vh 1.4vw; }
+.beamer .answer.fx-card { display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 0; border: 0; border-radius: 0; background: #070707; box-shadow: inset 0.7vw 0 0 var(--team), inset -0.7vw 0 0 var(--team), 0 1vh 2.4vh rgba(0, 0, 0, 0.55); overflow: visible; }
+.beamer .answer .ans-body { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; min-height: 13vh; padding: 1.4vh 2vw; color: #fff; font-family: var(--font); font-weight: 700; font-size: clamp(1rem, min(2.4vw, 4.4vh), 2.8rem); line-height: 1.1; overflow-wrap: anywhere; }
+.beamer .answer.has-ink .ans-body { padding: 0.8vh 1.4vw; }
+.beamer .answer .ink-answer.beamer { height: 15vh; }
+.beamer .answer .ans-name { margin: 0 0.7vw; background: var(--box-2); color: #fff; text-align: center; padding: 0.9vh 0.6vw; font-family: var(--font); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(0.75rem, min(1.6vw, 2.8vh), 1.8rem); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.beamer .answer .mark { position: absolute; top: -1.6vh; right: -0.6vw; width: 6vh; height: 6vh; display: grid; place-items: center; border-radius: 50%; padding: 0; font-size: 3.4vh; box-shadow: 0 0.6vh 1.4vh rgba(0, 0, 0, 0.5); }
+
+/* Zwischenstand: Titel als Fragen-Banner, Zeilen als graue Boxen mit Teamfarbe */
+.beamer .q.rank-title { width: fit-content; max-width: 92vw; white-space: nowrap; padding-left: calc(var(--tri) * 1.6); padding-right: calc(var(--tri) * 1.6); font-family: var(--font-display); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(1rem, min(3.4vw, 5.6vh), 3.6rem); margin-bottom: 2.6vh; }
+.beamer .rank.rank-board { width: min(80vw, 140vh); max-width: none; gap: 1.2vh; }
+.beamer .rank.rank-board li { background: var(--box); border: 0; border-radius: 0; padding: 0 2vw 0 0; min-height: 8.4vh; gap: 1.6vw; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1rem, min(2.8vw, 4.8vh), 3rem); box-shadow: inset -0.6vw 0 0 var(--team), 0 0.8vh 2vh rgba(0, 0, 0, 0.5); }
+.beamer .rank.rank-board li .pos { align-self: stretch; display: grid; place-items: center; width: 9vh; background: var(--team); color: #0b0b0d; font-size: 1.05em; }
+.beamer .rank.rank-board li .nm { flex: 1; text-align: left; min-width: 0; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.beamer .rank.rank-board li .pts { color: var(--accent-2); font-variant-numeric: tabular-nums; }
+.beamer .rank.rank-board li:first-child { box-shadow: inset -0.6vw 0 0 var(--team), 0 0 0 0.35vh var(--accent-2), 0 0 3vh rgba(255, 194, 61, 0.35); }
+.beamer .rank.rank-board.n7 li, .beamer .rank.rank-board.n8 li { min-height: 7vh; }
+.beamer .rank:not(.rank-board) li { border-radius: 0; background: var(--box); }
+
+/* Spiel 5: Hinweise als graue Leisten */
+.beamer .t5 .hints li { border-radius: 0; background: var(--box); border-left: 0.5vw solid var(--accent); box-shadow: 0 0.6vh 1.6vh rgba(0, 0, 0, 0.45); }
+.beamer .t5 .hints li.empty { background: rgba(32, 31, 34, 0.5); }
+.beamer .t5 .hints li .pv { border-radius: 0; }
+
+/* Spiel 6: Musik-Board */
+.beamer .jeopardy .cat { border-radius: 0; background: var(--box-2); box-shadow: inset 0 0.6vh 0 var(--accent); color: #fff; }
+.beamer .jeopardy .cell { border-radius: 0; background: var(--box); border-width: 0.4vh; box-shadow: 0 0.6vh 1.6vh rgba(0, 0, 0, 0.45); }
+.beamer .jeopardy .cell.played { background: rgba(32, 31, 34, 0.45); border-color: transparent; }
+
+/* Spiel 8 */
+.beamer .nerd-score { background: var(--box); padding: 1.2vh 3vw; width: fit-content; margin: 3vh auto 0; box-shadow: 0 1vh 2.4vh rgba(0, 0, 0, 0.5); }
+.beamer .nerd-score .big-num { color: var(--accent-2); }
+
+/* Spiel 7: sechs Teams in zwei Reihen à drei, ohne abgeschnitten zu werden */
+.wwm-teams { display: grid; grid-template-columns: repeat(3, minmax(0, auto)); justify-content: center; gap: 0.8vh 1vw; margin-top: 1.2vh; }
+.wwm-teams .chip { font-size: clamp(0.7rem, 2.1vh, 1.4rem); white-space: nowrap; }
+.beamer .chip.team-chip { box-shadow: inset 0.9vh 0 0 var(--chip), 0 0.6vh 1.6vh rgba(0, 0, 0, 0.45); padding-left: 1.5em; }
+.beamer .chip.team-chip.answering { box-shadow: inset 0.9vh 0 0 var(--chip), inset 0 0 0 0.45vh var(--accent-2), 0 0 2.4vh rgba(255, 194, 61, 0.45); }
+/* Spiel 3: Karte passt mit Frage auf den Beamer, rechteckig wie die übrigen Boxen */
+.beamer .map-box.beamer-map { width: fit-content; max-width: 92vw; border-radius: 0; border: 0; box-shadow: 0 0 0 0.5vh var(--box-2, #2b2b2e), 0 1vh 3vh rgba(0, 0, 0, 0.55); }
+.beamer .map-box.beamer-map .map { width: auto; height: 68vh; max-width: 92vw; }
+.beamer .map .pin-label { font-size: 20px; }
+/* Deutschlandkarte: Deutschland hell hervorgehoben, Nachbarländer gedämpft */
+.map .land.has-hl path { fill: #2c4a35; stroke: #16281c; stroke-width: 1; }
+.map .land.has-hl path.hl { fill: #4a8a5c; stroke: #e8f5ec; stroke-width: 2.2; }
+/* Editor: Datei-Felder (Video, Audio, Bild) */
+.media-field .media-row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
+.media-field .media-info { display: grid; gap: 6px; flex: 1; min-width: 200px; }
+.media-preview.img { width: 160px; height: 100px; object-fit: contain; background: #000; border-radius: 6px; }
+.media-preview.video { width: 220px; max-height: 130px; background: #000; border-radius: 6px; }
+.media-preview.audio { width: 260px; }
+/* Team-iPad: kleineres Schreibfeld (zwei Felder untereinander) */
+.ink.ink-small .ink-frame { height: 26vh; min-height: 180px; }
+
+/* ===== Zusätzliche Spiele (Spiele-Datenbank) ===== */
+/* Team-iPad */
+.stakes { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin: 6px 0 12px; }
+.stake { min-height: 70px; border: 3px solid var(--surface-2); background: var(--surface); color: var(--text); font: 800 2rem var(--font-display); border-radius: var(--radius); cursor: pointer; }
+.stake.selected, .abcd-opt.selected { border-color: var(--accent-2); box-shadow: 0 0 0 3px var(--accent-2) inset; }
+.stake:disabled { opacity: 0.25; text-decoration: line-through; cursor: not-allowed; }
+.stakes-label { font-weight: 700; margin: 14px 0 0; }
+.dumm-summary { font-weight: 700; color: var(--accent-2); min-height: 1.4em; }
