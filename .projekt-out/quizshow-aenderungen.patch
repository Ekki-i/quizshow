+      const tieAll = game.content.rounds[st.index].tie !== 'Moderation entscheidet';
+      const best = rows.filter((x) => key(x) === key(rows[0]) && x.valid);
+      const worst = rows.filter((x) => key(x) === key(rows[rows.length - 1]));
