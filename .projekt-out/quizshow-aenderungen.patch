index 0000000..09aae8e
--- /dev/null
+++ b/server/play-songsong.js
@@ -0,0 +1,133 @@
+'use strict';
+
+// Spiel „Song Song Song“: Mash-up aus Melodie des einen und Text des anderen
+// Songs. Jedes Team schreibt beide Titel; der Buzzer schickt die Antwort sofort
+// verbindlich ab und sperrt KEINE anderen Teams. Die Moderation prüft in
+// Buzzer-Reihenfolge: das erste Team mit beiden Titeln richtig bekommt 1 Punkt.
+
+const { fail, log, effect, teamName, bookTarget, cleanInk } = require('./core');
+
+function round(st, i) {
+  if (!st.rounds[i]) st.rounds[i] = { started: false, playback: { state: 'stopped', seq: 0 }, subs: [], grades: {}, winner: null, done: false };
+  return st.rounds[i];
+}
+
+function current(st) {
+  if (st.index < 0) fail('Es läuft gerade kein Rätsel.');
+  return round(st, st.index);
+}
+
+// Nächste noch nicht geprüfte Abgabe in Buzzer-Reihenfolge.
+function nextToCheck(r) {
+  return r.subs.find((s) => r.grades[s.teamId] === undefined) || null;
+}
+
+module.exports = {
+  init: () => ({ index: -1, rounds: {} }),
+  nextToCheck,
+
+  team: {
+    submit(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.started) fail('Die Musik läuft noch nicht.');
+      if (r.done) fail('Dieses Rätsel ist beendet.');
+      if (r.subs.some((s) => s.teamId === ctx.teamId)) fail('Ihr habt schon abgeschickt.');
+      const ink = cleanInk(p.ink);
+      if (!ink) fail('Bitte zuerst die Titel aufschreiben.');
+      r.subs.push({ teamId: ctx.teamId, ink, at: ctx.now });
+      log(db, ctx, 'buzzer', `${teamName(db, ctx.teamId)} schickt ab (Platz ${r.subs.length})`);
+      effect(db, 'buzz');
+    },
+  },
+
+  mod: {
+    open(db, ctx, game, st, p) {
+      const i = Number(p.index);
+      if (!game.content.puzzles[i]) fail('Rätsel nicht gefunden.');
+      if (st.index >= 0 && st.index !== i) {
+        const prev = round(st, st.index);
+        if (prev.playback.state === 'playing') prev.playback = { state: 'stopped', seq: prev.playback.seq + 1 };
+      }
+      st.index = i;
+      round(st, i);
+      log(db, ctx, 'ablauf', `Rätsel ${i + 1} vorbereitet`);
+    },
+
+    play(db, ctx, game, st) {
+      const r = current(st);
+      if (!game.content.puzzles[st.index].audio) fail('Für dieses Rätsel ist noch keine Datei hochgeladen.');
+      r.started = true;
+      r.playback = { state: 'playing', seq: r.playback.seq + 1 };
+      log(db, ctx, 'ablauf', `Rätsel ${st.index + 1}: Musik läuft`);
+    },
+
+    stop(db, ctx, game, st) {
+      const r = current(st);
+      r.playback = { state: 'stopped', seq: r.playback.seq + 1 };
+    },
+
+    // Abgaben in Buzzer-Reihenfolge prüfen: Punkt nur bei beiden Titeln richtig.
+    judge(db, ctx, game, st, p) {
+      const r = current(st);
+      if (r.done) fail('Dieses Rätsel ist beendet.');
+      const s = nextToCheck(r);
+      if (!s) fail('Keine Abgabe zu prüfen.');
+      r.grades[s.teamId] = !!p.correct;
+      if (p.correct) {
+        r.winner = s.teamId;
+        r.done = true;
+        r.playback = { state: 'stopped', seq: r.playback.seq + 1 };
+        bookTarget(db, ctx, `songsong:${game.id}:${st.index}`, s.teamId, 1, `${game.title}, Rätsel ${st.index + 1}`);
+        log(db, ctx, 'bewertung', `${teamName(db, s.teamId)}: beide Titel richtig`);
+        effect(db, 'correct');
+      } else {
+        log(db, ctx, 'bewertung', `${teamName(db, s.teamId)}: nicht beide Titel richtig`);
+        effect(db, 'wrong');
+      }
+    },
+
+    // Rätsel ohne Punkt beenden (niemand hatte beide Titel).
+    close(db, ctx, game, st) {
+      const r = current(st);
+      r.done = true;
+      r.playback = { state: 'stopped', seq: r.playback.seq + 1 };
+      log(db, ctx, 'ablauf', `Rätsel ${st.index + 1} beendet${r.winner ? '' : ' – kein Punkt'}`);
+    },
+  },
+
+  teamView(db, game, st, teamId) {
+    if (st.index < 0) return null;
+    const r = round(st, st.index);
+    const own = r.subs.find((s) => s.teamId === teamId);
+    const p = game.content.puzzles[st.index];
+    return {
+      index: st.index,
+      count: game.content.puzzles.length,
+      started: r.started,
+      canSubmit: r.started && !r.done && !own,
+      submitted: !!own,
+      place: own ? r.subs.indexOf(own) + 1 : null,
+      grade: own ? r.grades[teamId] ?? null : null,
+      done: r.done,
+      won: r.winner === teamId,
+      solution: r.done ? [p.melody, p.lyrics] : null,
+    };
+  },
+
+  beamerView(db, game, st) {
+    if (st.index < 0) return { waiting: true };
+    const r = round(st, st.index);
+    const p = game.content.puzzles[st.index];
+    return {
+      index: st.index,
+      audio: p.audio ? { id: p.audio.id, type: p.audio.type } : null,
+      playback: r.playback,
+      started: r.started,
+      // Reihenfolge der Abgaben ist öffentlich, die Antworten selbst nicht.
+      order: r.subs.map((s) => ({ teamId: s.teamId, grade: r.grades[s.teamId] ?? null })),
+      done: r.done,
+      winner: r.winner,
+      solution: r.done ? [p.melody, p.lyrics] : null,
+    };
+  },
+};
diff --git a/server/play-weissnicht.js b/server/play-weissnicht.js
new file mode 100644
index 0000000..5e99b11
--- /dev/null
+++ b/server/play-weissnicht.js
@@ -0,0 +1,155 @@
+'use strict';
+
+// Spiel „Ich weiß nicht, dass du weißt es doch“: Bild auf dem Beamer. Wer zuerst
+// buzzert, wählt ein anderes Team, das die Antwort angeblich nicht weiß (alle
+// übrigen Buzzer sind sofort gesperrt). Das gewählte Team hat 10 Sekunden für
+// eine mündliche Antwort. Falsch: +1 für das Buzzer-Team, richtig: +1 für das
+// gewählte Team.
+
+const { fail, log, effect, teamName, teamIds, bookTarget } = require('./core');
+
+const ANSWER_MS = 10000;
+
+function round(st, i) {
+  if (!st.rounds[i]) st.rounds[i] = { open: false, buzz: null, target: null, deadline: null, result: null, closed: false };
+  return st.rounds[i];
+}
+
+function current(st) {
+  if (st.index < 0) fail('Es läuft gerade keine Runde.');
+  return round(st, st.index);
+}
+
+function pick(db, ctx, game, st, r, teamId) {
+  if (!r.buzz) fail('Noch hat niemand gebuzzert.');
+  if (r.target) fail('Das Team ist schon gewählt.');
+  if (teamId === r.buzz.teamId || !teamIds(db).includes(teamId)) fail('Bitte ein anderes Team wählen.');
+  r.target = teamId;
+  r.deadline = ctx.now + ANSWER_MS;
+  log(db, ctx, 'ablauf', `${teamName(db, r.buzz.teamId)} wählt ${teamName(db, teamId)} – 10 Sekunden`);
+  effect(db, 'buzz');
+}
+
+// Je Team eine eigene Buchung: so bleibt auch eine Korrektur eindeutig.
+function book(db, ctx, game, st, r, correct) {
+  r.result = correct ? 'right' : 'wrong';
+  const winner = correct ? r.target : r.buzz.teamId;
+  const loser = correct ? r.buzz.teamId : r.target;
+  bookTarget(db, ctx, `weissnicht:${game.id}:${st.index}:${winner}`, winner, 1, `${game.title}, Runde ${st.index + 1}`);
+  bookTarget(db, ctx, `weissnicht:${game.id}:${st.index}:${loser}`, loser, 0, `${game.title}, Runde ${st.index + 1}`);
+  log(db, ctx, 'bewertung', `${teamName(db, r.target)} ${correct ? 'wusste es' : 'wusste es nicht'} – +1 für ${teamName(db, winner)}`);
+}
+
+module.exports = {
+  ANSWER_MS,
+  init: () => ({ index: -1, rounds: {} }),
+
+  team: {
+    buzz(db, ctx, game, st) {
+      const r = current(st);
+      if (!r.open || r.closed) fail('Diese Runde ist nicht offen.');
+      if (r.buzz) fail(`${teamName(db, r.buzz.teamId)} war schneller.`);
+      r.buzz = { teamId: ctx.teamId, at: ctx.now };
+      log(db, ctx, 'buzzer', `${teamName(db, ctx.teamId)} buzzert als erstes Team`);
+      effect(db, 'buzz');
+    },
+
+    pick(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.buzz || r.buzz.teamId !== ctx.teamId) fail('Nur das Team, das zuerst gebuzzert hat, wählt.');
+      pick(db, ctx, game, st, r, p.teamId);
+    },
+  },
+
+  mod: {
+    open(db, ctx, game, st, p) {
+      const i = Number(p.index);
+      if (!game.content.rounds[i]) fail('Runde nicht gefunden.');
+      if (st.index >= 0 && st.index !== i) {
+        const prev = round(st, st.index);
+        if (prev.target && !prev.result) fail('Erst die laufende Antwort bewerten.');
+        prev.open = false;
+      }
+      st.index = i;
+      const r = round(st, i);
+      if (!r.closed) r.open = true;
+      log(db, ctx, 'ablauf', `Runde ${i + 1} offen – Buzzer frei`);
+    },
+
+    // Falls das Buzzer-Team nicht selbst wählen kann (z. B. iPad weg).
+    pick(db, ctx, game, st, p) {
+      pick(db, ctx, game, st, current(st), p.teamId);
+    },
+
+    judge(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.target) fail('Es wurde noch kein Team gewählt.');
+      if (r.result) fail('Diese Runde ist schon bewertet.');
+      r.closed = true;
+      r.open = false;
+      book(db, ctx, game, st, r, !!p.correct);
+      effect(db, p.correct ? 'correct' : 'wrong');
+    },
+
+    // Bewertung umdrehen, falls die Moderation sich verklickt hat.
+    regrade(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.result) fail('Noch nicht bewertet.');
+      book(db, ctx, game, st, r, !!p.correct);
+    },
+
+    // Frage beenden (auch ohne Buzzer): danach keine Buzzer oder Antworten mehr.
+    close(db, ctx, game, st) {
+      const r = current(st);
+      if (r.target && !r.result) fail('Erst die Antwort bewerten.');
+      r.closed = true;
+      r.open = false;
+      log(db, ctx, 'ablauf', `Runde ${st.index + 1} beendet`);
+    },
+  },
+
+  wakeAt(db, game, st, now) {
+    if (st.index < 0) return null;
+    const r = round(st, st.index);
+    return r.deadline && !r.result && r.deadline > now ? r.deadline : null;
+  },
+
+  teamView(db, game, st, teamId) {
+    if (st.index < 0) return null;
+    const r = round(st, st.index);
+    const isBuzzer = r.buzz?.teamId === teamId;
+    return {
+      index: st.index,
+      count: game.content.rounds.length,
+      question: game.content.rounds[st.index].question,
+      open: r.open && !r.closed,
+      canBuzz: r.open && !r.closed && !r.buzz,
+      buzzer: r.buzz ? r.buzz.teamId : null,
+      isBuzzer,
+      choose: isBuzzer && !r.target ? teamIds(db).filter((id) => id !== teamId) : null,
+      target: r.target,
+      isTarget: r.target === teamId,
+      deadline: r.deadline,
+      result: r.result,
+      closed: r.closed,
+      solution: r.result || r.closed ? game.content.rounds[st.index].solution : null,
+    };
+  },
+
+  beamerView(db, game, st) {
+    if (st.index < 0) return { waiting: true };
+    const r = round(st, st.index);
+    const item = game.content.rounds[st.index];
+    return {
+      index: st.index,
+      image: item.image ? { id: item.image.id, type: item.image.type } : null,
+      question: item.question,
+      buzzer: r.buzz ? r.buzz.teamId : null,
+      target: r.target,
+      deadline: r.deadline,
+      result: r.result,
+      closed: r.closed,
+      solution: r.result || r.closed ? item.solution : null,
+    };
+  },
+};
diff --git a/server/play-weissnicht2.js b/server/play-weissnicht2.js
new file mode 100644
index 0000000..277af6d
--- /dev/null
+++ b/server/play-weissnicht2.js
@@ -0,0 +1,173 @@
+'use strict';
+
+// Spiel „Ich weiß nicht, dass du weißt es doch 2.0“: Alle Teams schreiben ihre
+// Antwort. Wer abgegeben hat, darf buzzern – nur der erste Buzzer zählt und
+// sperrt nur die Buzzer der anderen, nicht deren Abgabe. Erst wenn alle
+// abgegeben haben, schätzt das Buzzer-Team ein, welche Teams richtig liegen
+// (mindestens ein Team). Jede richtige Einschätzung +1, aber eine falsche macht
+// alle Einschätzungspunkte zunichte. Die eigene richtige Antwort bringt +1.
+
+const { fail, log, effect, teamName, teamIds, bookTarget, cleanInk } = require('./core');
+
+function round(st, i) {
+  if (!st.rounds[i]) st.rounds[i] = { open: false, answers: {}, buzz: null, guesses: null, grades: {}, closedSubmissions: false, evaluated: false };
+  return st.rounds[i];
+}
+
+function current(st) {
+  if (st.index < 0) fail('Es läuft gerade keine Runde.');
+  return round(st, st.index);
+}
+
+// Einschätzen ist erst möglich, wenn alle Teams abgegeben haben (oder die Moderation die Abgabe schließt).
+function allIn(db, r) {
+  return r.closedSubmissions || teamIds(db).every((id) => r.answers[id]);
+}
+
+function score(db, r) {
+  if (!r.buzz) return { buzzer: null, guessPoints: 0, ownPoint: 0, allRight: null };
+  const g = r.guesses || {};
+  const ids = Object.keys(g);
+  const allRight = ids.length > 0 && ids.every((id) => r.grades[id] === g[id]);
+  return {
+    buzzer: r.buzz.teamId,
+    guessPoints: allRight ? ids.length : 0,
+    ownPoint: r.grades[r.buzz.teamId] === true ? 1 : 0,
+    allRight,
+  };
+}
+
+module.exports = {
+  init: () => ({ index: -1, rounds: {} }),
+  score,
+
+  team: {
+    submit(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.open || r.closedSubmissions) fail('Die Abgabe ist geschlossen.');
+      if (r.answers[ctx.teamId]) fail('Ihr habt schon abgegeben.');
+      const ink = cleanInk(p.ink);
+      if (!ink) fail('Bitte zuerst eure Antwort aufschreiben.');
+      r.answers[ctx.teamId] = { ink, at: ctx.now };
+      log(db, ctx, 'antwort', `${teamName(db, ctx.teamId)} hat abgegeben`);
+    },
+
+    buzz(db, ctx, game, st) {
+      const r = current(st);
+      if (!r.open) fail('Die Runde ist nicht offen.');
+      if (!r.answers[ctx.teamId]) fail('Erst die eigene Antwort abgeben, dann buzzern.');
+      if (r.buzz) fail(`${teamName(db, r.buzz.teamId)} war schneller.`);
+      r.buzz = { teamId: ctx.teamId, at: ctx.now };
+      log(db, ctx, 'buzzer', `${teamName(db, ctx.teamId)} buzzert als erstes Team`);
+      effect(db, 'buzz');
+    },
+
+    // Einschätzung des Buzzer-Teams: { guesses: { teamId: true|false } }
+    guess(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.buzz || r.buzz.teamId !== ctx.teamId) fail('Nur das schnellste Team schätzt ein.');
+      if (!allIn(db, r)) fail('Erst wenn alle Teams abgegeben haben, wird eingeschätzt.');
+      if (r.guesses) fail('Eure Einschätzung ist schon abgegeben.');
+      const src = p.guesses && typeof p.guesses === 'object' ? p.guesses : {};
+      const out = {};
+      for (const [id, v] of Object.entries(src)) {
+        if (id === ctx.teamId || !r.answers[id] || typeof v !== 'boolean') continue;
+        out[id] = v;
+      }
+      if (!Object.keys(out).length) fail('Bitte mindestens ein Team einschätzen.');
+      r.guesses = out;
+      log(db, ctx, 'einschätzung', `${teamName(db, ctx.teamId)} hat ${Object.keys(out).length} Team(s) eingeschätzt`);
+    },
+  },
+
+  mod: {
+    open(db, ctx, game, st, p) {
+      const i = Number(p.index);
+      if (!game.content.rounds[i]) fail('Runde nicht gefunden.');
+      if (st.index >= 0 && st.index !== i) round(st, st.index).open = false;
+      st.index = i;
+      const r = round(st, i);
+      if (!r.evaluated) r.open = true;
+      log(db, ctx, 'ablauf', `Runde ${i + 1} offen`);
+    },
+
+    // Abgabe schließen, falls ein Team nicht abgibt – dann darf eingeschätzt werden.
+    closeSubmissions(db, ctx, game, st) {
+      const r = current(st);
+      r.closedSubmissions = true;
+      log(db, ctx, 'ablauf', `Runde ${st.index + 1}: Abgabe geschlossen`);
+    },
+
+    grade(db, ctx, game, st, p) {
+      const r = current(st);
+      if (!r.answers[p.teamId]) fail('Dieses Team hat nicht abgegeben.');
+      if (r.evaluated) fail('Die Runde ist schon ausgewertet.');
+      r.grades[p.teamId] = !!p.correct;
+    },
+
+    evaluate(db, ctx, game, st) {
+      const r = current(st);
+      if (r.evaluated) fail('Schon ausgewertet.');
+      if (!allIn(db, r)) fail('Noch haben nicht alle Teams abgegeben.');
+      const missing = Object.keys(r.answers).filter((id) => r.grades[id] === undefined);
+      if (missing.length) fail(`Noch nicht bewertet: ${missing.map((id) => teamName(db, id)).join(', ')}`);
+      if (r.buzz && !r.guesses) fail('Das Buzzer-Team hat noch nicht eingeschätzt.');
+      r.evaluated = true;
+      r.open = false;
+      const s = score(db, r);
+      if (s.buzzer) {
+        bookTarget(db, ctx, `weissnicht2:${game.id}:${st.index}:guess`, s.buzzer, s.guessPoints, `${game.title}, Runde ${st.index + 1}, Einschätzung`);
+        bookTarget(db, ctx, `weissnicht2:${game.id}:${st.index}:own`, s.buzzer, s.ownPoint, `${game.title}, Runde ${st.index + 1}, eigene Antwort`);
+      }
+      log(db, ctx, 'ablauf', `Runde ${st.index + 1} ausgewertet${s.buzzer ? ` – ${teamName(db, s.buzzer)}: ${s.guessPoints + s.ownPoint} Punkte` : ''}`);
+      effect(db, 'reveal');
+    },
+  },
+
+  teamView(db, game, st, teamId) {
+    if (st.index < 0) return null;
+    const r = round(st, st.index);
+    const isBuzzer = r.buzz?.teamId === teamId;
+    const ready = allIn(db, r);
+    const s = r.evaluated ? score(db, r) : null;
+    return {
+      index: st.index,
+      count: game.content.rounds.length,
+      question: game.content.rounds[st.index].question,
+      open: r.open && !r.closedSubmissions,
+      submitted: !!r.answers[teamId],
+      canBuzz: r.open && !!r.answers[teamId] && !r.buzz,
+      buzzTaken: !!r.buzz,
+      isBuzzer,
+      // Einschätzen: erst nach allen Abgaben, nur fürs Buzzer-Team. Antworten der anderen bleiben geheim.
+      guessTeams: isBuzzer && ready && !r.guesses ? Object.keys(r.answers).filter((id) => id !== teamId) : null,
+      waitingForAll: isBuzzer && !ready,
+      guessed: isBuzzer && !!r.guesses,
+      evaluated: r.evaluated,
+      ownCorrect: r.evaluated ? r.grades[teamId] ?? null : null,
+      result: s && isBuzzer ? s : null,
+      solution: r.evaluated ? game.content.rounds[st.index].solution : null,
+    };
+  },
+
+  beamerView(db, game, st) {
+    if (st.index < 0) return { waiting: true };
+    const r = round(st, st.index);
+    const item = game.content.rounds[st.index];
+    const s = r.evaluated ? score(db, r) : null;
+    return {
+      index: st.index,
+      image: item.image ? { id: item.image.id, type: item.image.type } : null,
+      question: item.question,
+      submittedCount: Object.keys(r.answers).length,
+      teamCount: db.project.teams.length,
+      buzzer: r.buzz ? r.buzz.teamId : null,
+      guessing: !!r.buzz && allIn(db, r) && !r.guesses,
+      evaluated: r.evaluated,
+      // Erst nach der Auswertung: Antworten, Bewertungen und Einschätzungen.
+      answers: r.evaluated ? Object.entries(r.answers).map(([teamId, a]) => ({ teamId, ink: a.ink, correct: r.grades[teamId] ?? null, guess: r.guesses ? r.guesses[teamId] ?? null : null })) : [],
+      score: s,
+      solution: r.evaluated ? item.solution : null,
+    };
+  },
+};
diff --git a/server/play-zocken.js b/server/play-zocken.js
new file mode 100644
index 0000000..ce14e5e
--- /dev/null
+++ b/server/play-zocken.js
@@ -0,0 +1,181 @@
+'use strict';
+
+// Spiel „Erst ich, dann du, dann du, dann du“: 24 nummerierte Felder mit
+// schweren Fragen. Die Moderation öffnet eine Frage, alle dürfen buzzern.
+// Richtig: +1 ungesicherter Punkt in der Zock-Serie des Teams, danach
